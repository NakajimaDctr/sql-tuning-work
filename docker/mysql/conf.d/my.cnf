[mysqld]
# 学習用: すべてのクエリをスロークエリログに記録し、EXPLAIN以外でも
# 実際に発行されたSQLを確認できるようにする
slow_query_log      = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time     = 0.1

# performance_schema はStage 6, 7の内部動作確認で使用する
performance_schema = ON

# 学習用のため小さめのマシンでも動くようにバッファプールを抑えめに設定
innodb_buffer_pool_size = 512M

character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci
